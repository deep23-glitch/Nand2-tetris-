CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:

    // Instruction decoding
    Not(in=instruction[15], out=isA);
    And(a=instruction[15], b=instruction[5], out=destA);
    Or(a=isA, b=destA, out=loadA);

    // A Register
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aIn);
    ARegister(in=aIn, load=loadA, out=aReg, out[0..14]=addressM);

    // D Register
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dReg);

    // ALU Input
    Mux16(a=aReg, b=inM, sel=instruction[12], out=y);

    // ALU
    ALU(
        x=dReg,
        y=y,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        out=outM,
        zr=zr,
        ng=ng
    );

    // Memory Write
    And(a=instruction[15], b=instruction[3], out=writeM);

    // Jump Logic
    Not(in=zr, out=notZr);
    Not(in=ng, out=notNg);

    And(a=notNg, b=notZr, out=positive);
    And(a=instruction[2], b=positive, out=jumpGT);
    And(a=instruction[1], b=zr, out=jumpEQ);
    And(a=instruction[0], b=ng, out=jumpLT);

    Or(a=jumpGT, b=jumpEQ, out=jump1);
    Or(a=jump1, b=jumpLT, out=jump);

    And(a=instruction[15], b=jump, out=pcLoad);

    // Program Counter
    PC(
        in=aReg,
        load=pcLoad,
        inc=true,
        reset=reset,
        out[0..14]=pc
    );
}
